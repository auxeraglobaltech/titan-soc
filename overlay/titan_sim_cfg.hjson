// titan-soc trainee simulation config.
//
// Imports the vendor chip sim cfg UNTOUCHED and layers trainee test entries
// on top — the sanctioned dvsim way to register new tests without editing
// anything under vendor/. Used by sim/run_xcelium.sh.
//
// Trainee SW test sources live in titan-soc/sw/trainee/ (committed) and are
// synced into vendor/opentitan/sw/device/tests/titan/ (untracked bazel
// package) by scripts/sync_trainee_sw.sh — see docs/TRAINEE_GUIDE.md.
{
  // Everything from upstream: chip env, build modes, all chip_sw_* tests.
  import_cfgs: ["{proj_root}/hw/top_earlgrey/dv/chip_sim_cfg.hjson"]

  // This cfg lives OUTSIDE proj_root (vendor/opentitan), so dvsim cannot
  // derive rel_path from it (flow/base.py does relative_to(proj_root) and
  // would raise). Pin it to the vendor cfg's own location — only used for
  // report/testplan paths.
  rel_path: "hw/top_earlgrey/dv"

  // ---------------------------------------------------------------------
  // Trainee tests — one entry per test. Pattern for a minimal C test:
  //   new .c + opentitan_test() in sw/trainee/BUILD + one entry here,
  //   then ./scripts/sync_trainee_sw.sh before running.
  // ---------------------------------------------------------------------
  // Pattern copied from the upstream template `chip_sw_example_flash`:
  // sw_test_mode_test_rom provides the TEST ROM image AND chains
  // format_sw_images + gen_otp_images_mode (without it the sim dies at t=0:
  // "otp_ctrl_img_rma.vmem could not be opened" — no OTP image in run_dir).
  tests: [
    {
      name: titan_sw_hello_test
      uvm_test_seq: chip_sw_base_vseq
      sw_images: ["//sw/device/tests/titan:hello_test:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      run_timeout_mins: 60
    }
  ]
}
